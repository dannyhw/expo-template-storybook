{
  "name": "expo-template-storybook",
  "description": "template for react native storybook and react native web",
  "version": "7.0.0",
  "main": "expo-router/entry",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "storybook:web": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook-generate": "sb-rn-get-stories",
    "storybook": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED='true' expo start",
    "storybook:ios": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED='true' expo start --ios",
    "storybook:android": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED='true' expo start --android",
    "prepack": "node scripts/pack-manifest.js strip",
    "postpack": "node scripts/pack-manifest.js restore"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "^57.0.27",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@chromatic-com/storybook": "^5.4.0",
    "@expo/metro-runtime": "~57.0.16",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-ondevice-actions": "^10.6.2",
    "@storybook/addon-ondevice-controls": "^10.6.2",
    "@storybook/addon-ondevice-notes": "^10.6.2",
    "@storybook/react": "^10.6.1",
    "@storybook/react-native": "^10.6.2",
    "@storybook/react-native-web-vite": "^10.6.1",
    "@types/react": "~19.2.18",
    "babel-plugin-react-docgen-typescript": "^1.5.1",
    "cross-env": "^10.1.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "resolutions": {
    "react-docgen-typescript": "2.2.2"
  },
  "overrides": {
    "react-docgen-typescript": "2.2.2"
  }
}
